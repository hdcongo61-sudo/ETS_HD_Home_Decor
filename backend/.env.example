# ──────────────────────────────────────────────────────────────
# ETS HD Home Decor — backend environment variables
# Copy to `.env` and fill in the values.
# ──────────────────────────────────────────────────────────────

PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/ets_hd_home_decor
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:3000

# ── PawaPay (mobile money subscription payments) ──────────────
# API token generated from the PawaPay dashboard. Sandbox and
# production tokens are DIFFERENT. The mobile-money payment UI is
# hidden until a token is set.
PAWAPAY_API_TOKEN=
# Sandbox (default): https://api.sandbox.pawapay.io
# Production:        https://api.pawapay.io
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
# Optional: JSON array overriding the built-in provider list.
# The provider IDs must be enabled on YOUR PawaPay account.
# Example:
# PAWAPAY_PROVIDERS=[{"id":"MTN_MOMO_CIV","label":"MTN Mobile Money","country":"CIV","currency":"XOF"},{"id":"ORANGE_MONEY_CIV","label":"Orange Money","country":"CIV","currency":"XOF"}]
PAWAPAY_PROVIDERS=
# Optional: PEM public key to verify PawaPay-signed webhooks
# (RFC-9421). Without it, callbacks are accepted on trust (logged).
PAWAPAY_PUBLIC_KEY=

# ── Email (for platform user communication) ────────────────────
# SMTP settings for sending emails to users. Used by super-admin
# to communicate with platform users.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM_NAME=ETS HD Home Decor
